# ══════════════════════════════════════════════════════════════
# OpenDayCare · plantilla de variables de entorno
# Copia esta plantilla y completa los valores vacíos:
#   Copy-Item .env-template .env.local
# .env y .env.local están ignorados por Git; este archivo sí se versiona,
# así que NUNCA escribas aquí contraseñas ni claves secretas.
# En Vercel: Settings → Environment Variables con estas mismas claves.
# ══════════════════════════════════════════════════════════════

# ── Supabase · producción ─────────────────────────────────────
# Project URL. Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://zyzdphhbahiijinfnmwl.supabase.co

# Publishable key (sb_publishable_...). Es pública: llega al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YIIiI3oYfKROWQggps1txA_uZGMpj7A

# Secret key del proyecto de PRODUCCIÓN (sb_secret_...). Solo servidor:
# Admin API e invitaciones. Nunca con prefijo NEXT_PUBLIC_ ni desde componentes cliente.
# La clave del proyecto de desarrollo NO sirve aquí (la API responde 401).
# Dashboard → Project Settings → API keys
SUPABASE_SECRET_KEY=

# Contraseña de la base. Solo la usa el CLI (supabase link / db push).
# La app no la necesita en runtime. Dashboard → Project Settings → Database
SUPABASE_DB_PASSWORD=

# ── App ───────────────────────────────────────────────────────
# URL absoluta de producción, sin barra final. Obligatoria al desplegar:
# de ella sale el enlace del correo de invitación.
# En desarrollo puede quedar vacía: se usa el origen de la petición.
APP_URL=

# ── Resend ────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=

# onboarding@resend.dev solo entrega al email dueño de la cuenta y a @resend.dev;
# los padres reales reciben 403. Cambiar por dominio verificado antes de producción real.
RESEND_FROM_EMAIL=OpenDayCare <onboarding@resend.dev>

# ── Opcional ──────────────────────────────────────────────────
# Zona horaria del feed y del resumen diario. Fallback: America/Mexico_City
DAYCARE_TIME_ZONE=America/Mexico_City

# ── Solo pruebas locales ──────────────────────────────────────
# Usuario de Supabase Auth para Playwright. Valores reales solo en .env.local.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
