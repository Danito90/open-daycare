
# Contraseña de la base de datos de Supabase. 
SUPABASE_DB_PASSWORD=

# Configuración pública para los clientes Supabase del navegador y del servidor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Credenciales de prueba para la verificación local con Playwright.
# Los valores reales deben ir en .env.local, que está ignorado por Git.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
