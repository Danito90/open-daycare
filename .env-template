# Contraseña de la base de datos de Supabase.
SUPABASE_DB_PASSWORD=

# Configuración pública para los clientes Supabase del navegador y del servidor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Clave secreta del proyecto (sb_secret_...). Solo se usa en el servidor:
# Admin API y funciones accept_invitation / email_has_account.
# Nunca debe llevar el prefijo NEXT_PUBLIC_ ni importarse desde componentes cliente.
SUPABASE_SECRET_KEY=

# Credenciales de prueba para la verificación local con Playwright.
# Los valores reales deben ir en .env.local, que está ignorado por Git.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Resend: https://resend.com/api-keys
# El remitente debe ser un dominio verificado o onboarding@resend.dev en pruebas.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL absoluta usada en el enlace del correo de invitación.
# Es obligatoria en producción; en desarrollo cae al origen de la petición.
APP_URL=
